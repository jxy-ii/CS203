# Copy this file to .env. The real .env is ignored by Git.
DATABASE_URL=jdbc:postgresql://localhost:5432/policy_impact
DATABASE_USERNAME=policy_user
DATABASE_PASSWORD=policy_password
JWT_SECRET=replace-with-a-base64-key-of-at-least-32-bytes

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large
OLLAMA_CHAT_MODEL=llama3.2

# Required only for profile-specific import urgency assessment.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

